# ========================================================
# HETA-HRM Environment Variables Configuration
# ========================================================

# ----------------- SMTP & Email Setup -------------------
# SMTP credentials for leave request dual email dispatch
# and automated absent alerts to parents & students.
# On Gmail: Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
HETA_SMTP_HOST=smtp.gmail.com
HETA_SMTP_PORT=587
HETA_SMTP_USER=hetahighereducation@gmail.com
HETA_SMTP_PASS=your-16-char-app-password
HETA_SMTP_SENDER=hetahighereducation@gmail.com
HETA_ADMIN_EMAILS=hetahighereducation@gmail.com,balajimanokaranmd@gmail.com

# ----------------- Google Sheets Sync -------------------
# Google Cloud Service Account JSON credentials string
# (paste the full JSON contents as a single-line string in Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ----------------- Frontend Config ----------------------
# Base URL for backend API.
# In local development: defaults to http://localhost:5050/api
# On Vercel: leave empty to use auto-routed relative /api
VITE_API_BASE=
