// Prisma Schema for HETA-HRM Student & Staff Attendance and Leave Management System
datasource db {
  provider = "sqlite"
  url      = "file:./heta.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    // 'ADMIN', 'STAFF', 'STUDENT'
  phone        String?
  memberId     String?   // Linked member record for student/staff
  sessionToken String?
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Member {
  id             String         @id @default(cuid())
  name           String
  code           String         @unique // e.g. STU-001, STF-001
  role           String         // 'STUDENT' or 'STAFF'
  course         String         @default("Python Programming")
  batch          String         @default("Batch-2026-A")
  department     String         @default("Computer Science")
  phone          String?
  email          String?
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  portionCovered String         @default("Python Core")
  status         String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
}

model Attendance {
  id             String   @id @default(cuid())
  memberId       String
  date           String   // YYYY-MM-DD
  status         String   // Exactly 3 options: 'PRESENT', 'ABSENT', 'HOLIDAY'
  inTime         String?  // e.g. 09:00 AM
  outTime        String?  // e.g. 05:00 PM
  notes          String?
  markedBy       String?  @default("Admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
}

model LeaveRequest {
  id                 String    @id @default(cuid())
  memberId           String
  studentName        String
  course             String
  batch              String
  leaveType          String    // CASUAL, SICK, ACADEMIC, EMERGENCY
  startDate          String    // YYYY-MM-DD (From Date)
  endDate            String    // YYYY-MM-DD (To Date)
  reason             String
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED
  appliedAt          DateTime  @default(now())
  reviewedBy         String?
  reviewedAt         DateTime?
  adminRemarks       String?
  emailSentToAdmin   Boolean   @default(false)
  emailSentToStudent Boolean   @default(false)
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model PortionCovered {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  course      String   @default("Python Programming")
  batch       String   @default("Batch-2026-A")
  subject     String   @default("Python Core")
  topic       String   // Chapter / Topic Covered
  remarks     String?
  conductedBy String   @default("Staff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GoogleSheetSync {
  id            String    @id @default(cuid())
  accountEmail  String    @default("hetahighereducation@gmail.com")
  sheetName     String    @default("HETA-HRM Attendance & Leave Master")
  sheetId       String?
  sheetUrl      String?
  lastSyncedAt  DateTime?
  syncStatus    String    @default("READY")
  recordsSynced Int       @default(0)
  log           String?
}
