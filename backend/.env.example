# =====================================================================
# HETA-HRM Backend Environment Variables (Local, Docker, or Cloud Host)
# =====================================================================

# 1. SMTP Email Server Configuration (for parent alerts & dual-email leave notices)
# For Gmail: Use a 16-character App Password (not your personal password)
HETA_SMTP_HOST=smtp.gmail.com
HETA_SMTP_PORT=587
HETA_SMTP_USER=hetahighereducation@gmail.com
HETA_SMTP_PASS=your_16_character_app_password_here
HETA_SMTP_SENDER=hetahighereducation@gmail.com

# 2. Dual Admin Notification Recipients (comma-separated)
HETA_ADMIN_EMAILS=hetahighereducation@gmail.com,balajimanokaranmd@gmail.com

# 3. Google Cloud Service Account for Live Sheets Sync
# (On Vercel / Cloud: paste the full JSON string from google-service-account.json)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

