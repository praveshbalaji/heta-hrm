# =====================================================================
# HETA-HRM Backend Environment Variables (Local, Docker, or Cloud Host)
# =====================================================================

# 1. Admin Credentials
ADMIN_EMAIL=pravesbalaji144@gmail.com
ADMIN_PASSWORD=your_secure_password_here

# 2. SMTP Email Server Configuration (for parent alerts & dual-email leave notices)
# For Gmail: Use a 16-character App Password (not your personal password)
HETA_SMTP_HOST=smtp.gmail.com
HETA_SMTP_PORT=587
HETA_SMTP_USER=pravesbalaji144@gmail.com
HETA_SMTP_PASS=your_16_character_app_password_here
HETA_SMTP_SENDER=pravesbalaji144@gmail.com

# 3. Dual Admin Notification Recipients (comma-separated)
HETA_ADMIN_EMAILS=pravesbalaji144@gmail.com,balajimanokaranmd@gmail.com

# 3. Google Cloud Service Account for Live Sheets Sync
# (On Vercel / Cloud: paste the full JSON string from google-service-account.json)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# ----------------- Persistent Database (REQUIRED on Vercel) -----------------
# PostgreSQL connection string. Free options: Neon (Vercel Storage tab adds this
# automatically), Supabase, or any Postgres. Leave empty locally to use SQLite.
# Without it on Vercel, data lives in /tmp and is wiped on every cold start.
DATABASE_URL=

# Seed demo students/staff/attendance on a brand-new empty database (true/false)
HETA_SEED_DEMO_DATA=false
